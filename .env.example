# 이 파일은 "이름만" 알려주는 예시입니다. 실제 값은 .env / .dev.vars 에 넣으세요(깃에 올라가지 않음).
# 모두 선택 사항이며, 없으면 코드에 내장된 기본값으로 동작합니다.

# 접근을 허용할 ChatGPT 계정 이메일. 쉼표로 여러 개 지정합니다.
# 지정하지 않으면 app/allowed-users.ts 의 해시 목록을 사용합니다.
ALLOWED_EMAILS=first@example.com,second@example.com

# 웹 푸시(VAPID) 설정. 두 키가 모두 있어야 푸시가 켜집니다.
# VAPID_SUBJECT 는 생략하면 사이트 주소가 사용됩니다.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
